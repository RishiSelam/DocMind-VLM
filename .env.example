# Copy to .env (repo root) or backend/.env. Backend/.env wins if both exist.

# --- mode ---
# true  = no GPU models: real PDF parsing, OCR and BM25, but answers come from heuristic extractors (UI shows a DEMO badge)
# false = real Qwen2.5-VL + Qwen2.5-7B, 4-bit, loaded at startup. Fails loudly if VRAM is short.
DEMO_MODE=true
OFFLINE=true                      # sets HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE

# --- models (Hugging Face ids, or local folders) ---
VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
ENABLE_VLM=true
ENABLE_LLM=true
MIN_FREE_VRAM_GB=12               # both 4-bit models; lower it if you load only one
MAX_NEW_TOKENS=256
VLM_MAX_PIXELS=1003520            # caps visual tokens per page (lower this if the VLM runs out of memory)

# --- OCR baseline ---
OCR_ENGINE=rapidocr               # rapidocr | docling | paddleocr | textlayer
USE_TEXT_LAYER=false              # false: always OCR the pixels (keeps the baseline honest)
OCR_RENDER_DPI=200

# --- explainability (short answers only; summaries are not located) ---
EXPLAIN=true                      # locate each answer's evidence on the page (both methods) and score trust
LOOK_CLOSER=true                  # when the answers differ: enlarge the evidence region and let the vision model re-read it
FAITHFULNESS=true                 # remove the evidence and ask again: did the answer really depend on it?

# --- page policy ---
READ_ALL_PAGES=true               # true: both pipelines read EVERY page (VLM in batches, OCR text in parts), then combine
VLM_PAGE_CAP=3                    # pages per VLM call (GPU memory); with READ_ALL_PAGES=false, the only pages the VLM sees
MATCH_PAGES=false                 # READ_ALL_PAGES=false only: OCR pipeline sees the SAME pages as the VLM
MAX_CONTEXT_CHARS=24000           # OCR text per LLM call; longer documents are split into parts (READ_ALL_PAGES=true)
HISTORY_TURNS=6                   # earlier Q/A turns given to the models (the database keeps all of them)

# --- server ---
# CORS_ORIGINS must be a JSON list. Only needed if the browser reaches the UI from somewhere other than localhost:3000.
# CORS_ORIGINS=["http://localhost:3000","http://192.168.1.20:3000"]
