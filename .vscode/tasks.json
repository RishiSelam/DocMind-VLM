{
  "version": "2.0.0",
  "tasks": [
    { "label": "backend: run", "type": "shell", "command": "uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" }, "isBackground": true, "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "docmind" } },
    { "label": "frontend: run", "type": "shell", "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "isBackground": true, "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "docmind" } },
    { "label": "docmind: run both", "dependsOn": ["backend: run", "frontend: run"], "dependsOrder": "parallel", "problemMatcher": [] },
    { "label": "backend: tests", "type": "shell", "command": "python -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [], "group": "test" },
    { "label": "backend: doctor", "type": "shell", "command": "python scripts/doctor.py",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] }
  ]
}
